# ============================================================
# Tunecraft - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Required ---

# Plex Media Server
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here

# Last.fm API (get free key at https://www.last.fm/api/account/create)
LASTFM_API_KEY=your_lastfm_api_key_here

# --- Optional ---

# Lidarr (for adding recommended artists)
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=your_lidarr_api_key_here

# AudioMuse-AI (for sonic similarity re-ranking)
AUDIOMUSE_URL=http://localhost:8000
AUDIOMUSE_TOKEN=your_audiomuse_token_here

# Discord Bot (for /tunecraft slash commands)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here

# App
PORT=3000
